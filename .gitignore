# Large reference and empirical data are excluded from Git.
data/reference/*
data/empirical/*
!data/reference/.gitkeep
!data/empirical/.gitkeep

# Raw genome/read/alignment data.
*.fasta
*.fna
*.fa.gz
*.fasta.gz
*.fna.gz
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.cram
*.bai
*.crai

# Allow committed synthetic validation FASTA files.
!data/synthetic/
!data/synthetic/*.fa
!data/synthetic/*.fasta
!data/synthetic/*.fna

# External comparator checkouts.
external/*
!external/.gitkeep

# Raw workflow, benchmark, and processed outputs.
results/raw/*
results/processed/*
results/tables/*
results/figures/*
benchmark/time/*
benchmark/memory/*
benchmark/logs/*
!results/raw/.gitkeep
!results/processed/.gitkeep
!results/tables/.gitkeep
!results/figures/.gitkeep
!benchmark/time/.gitkeep
!benchmark/memory/.gitkeep
!benchmark/logs/.gitkeep

# Manuscript exports.
# Final curated artifacts can be force-added with git add -f.
manuscript_tables/*
manuscript_figures/*
!manuscript_tables/.gitkeep
!manuscript_figures/.gitkeep

# Python/R/Snakemake/cache.
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.Rhistory
.RData
.julia/
.snakemake/
snakemake_cache/
.conda/
.mamba/

# OS/editor.
.DS_Store
.vscode/
.idea/

# Generated codebase snapshots.
codebase.json
*codebase*

.local/
