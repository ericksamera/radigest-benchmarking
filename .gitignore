/benchmark/logs/**
!/benchmark/logs/
!/benchmark/logs/.gitkeep

/benchmark/memory/**
!/benchmark/memory/
!/benchmark/memory/.gitkeep

# Temporary files
*.tmp
*.bak
*.log
.DS_Store

*codebase*
