# Large reference and empirical data.
data/reference/*
data/empirical/*
!data/reference/.gitkeep
!data/empirical/.gitkeep

# Raw genome/read/alignment data.
*.fasta
*.fna
*.fa.gz
*.fasta.gz
*.fna.gz
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.cram
*.bai
*.crai

# Allow committed small synthetic FASTA files.
!data/synthetic/
!data/synthetic/*.fa
!data/synthetic/*.fasta
!data/synthetic/*.fna

# Generated workflow and benchmark outputs.
results/raw/*
results/processed/*
results/tables/*
results/figures/*
benchmark/time/*
benchmark/memory/*
benchmark/logs/*

!results/raw/.gitkeep
!results/processed/.gitkeep
!results/tables/.gitkeep
!results/figures/.gitkeep
!benchmark/time/.gitkeep
!benchmark/memory/.gitkeep
!benchmark/logs/.gitkeep

# Generated manuscript exports.
# Curated final artifacts can be added explicitly with git add -f.
manuscript_figures/*
manuscript_tables/*
!manuscript_figures/.gitkeep
!manuscript_tables/.gitkeep

# External comparator checkouts.
external/*
!external/.gitkeep

# Python/R/Snakemake/cache.
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.Rhistory
.RData
.julia/
.snakemake/
snakemake_cache/
.conda/
.mamba/

# OS/editor.
.DS_Store
.vscode/
.idea/

# Generated codebase snapshots.
codebase.json
*codebase*
