# Large reference and empirical data are excluded from Git.
data/reference/*
data/empirical/*

!data/reference/.gitkeep
!data/empirical/.gitkeep

# Raw genome/read/alignment data.
*.fasta
*.fna
*.fa.gz
*.fasta.gz
*.fna.gz
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.cram
*.bai
*.crai

# Allow small designed synthetic validation FASTA.
!data/synthetic/
!data/synthetic/*.fa
!data/synthetic/*.fasta
!data/synthetic/*.fna

# Benchmark and raw workflow outputs.
results/raw/*
results/processed/*
benchmark/time/*
benchmark/memory/*
benchmark/logs/*

!results/raw/.gitkeep
!results/processed/.gitkeep
!benchmark/time/.gitkeep
!benchmark/memory/.gitkeep
!benchmark/logs/.gitkeep

# Curated manuscript-ready tables/figures may be tracked selectively.
# Generated scratch files should remain ignored unless intentionally staged.

# Generated summary outputs.
results/tables/*
results/figures/*

!results/tables/.gitkeep
!results/figures/.gitkeep

# Environments/cache.
.venv/
__pycache__/
.Rhistory
.RData
.julia/
.snakemake/
snakemake_cache/
.conda/
.mamba/

# OS/editor.
.DS_Store
.vscode/
.idea/

*codebase*

# Generated comparator outputs.
results/raw/comparators/*
results/raw/comparisons/*
results/processed/comparisons/*

# Generated comparator outputs.
results/raw/comparators/*
results/raw/comparisons/*
results/processed/comparisons/*

# Generated comparator outputs.
results/raw/comparators/*
results/raw/comparisons/*
results/processed/comparisons/*
results/raw/manual_test/*
results/processed/manual_test/*

# External tool checkouts.
external/*
!external/.gitkeep

# Generated Digital_RADs.py comparator outputs.
results/raw/comparators/digital_rads/*
results/raw/comparisons/radigest_tsv/*
results/processed/intervals/digital_rads/*
results/processed/intervals/radigest_for_digital/*
results/processed/comparisons/digital_rads/*
benchmark/logs/digital_rads__*
benchmark/logs/digital_radigest__*

# External tool checkouts.
external/*
!external/.gitkeep

# Generated comparator outputs and scratch directories.
results/raw/comparators/*
results/raw/comparisons/*
results/processed/comparisons/*
results/processed/intervals/*
results/raw/manual_test/*
results/processed/manual_test/*
benchmark/logs/*
benchmark/memory/*
benchmark/time/*

# Generated manuscript export directories.
# Final curated manuscript artifacts can be added explicitly with git add -f.
manuscript_figures/*
manuscript_tables/*
!manuscript_figures/.gitkeep
!manuscript_tables/.gitkeep
