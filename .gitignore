# Large reference and empirical data are excluded from Git.
data/reference/*
data/empirical/*

!data/reference/.gitkeep
!data/empirical/.gitkeep

# Raw genome/read/alignment data.
*.fasta
*.fna
*.fa.gz
*.fasta.gz
*.fna.gz
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.cram
*.bai
*.crai

# Allow small designed synthetic validation FASTA.
!data/synthetic/
!data/synthetic/*.fa
!data/synthetic/*.fasta
!data/synthetic/*.fna

# Benchmark and raw workflow outputs.
results/raw/*
results/processed/*
benchmark/time/*
benchmark/memory/*
benchmark/logs/*

!results/raw/.gitkeep
!results/processed/.gitkeep
!benchmark/time/.gitkeep
!benchmark/memory/.gitkeep
!benchmark/logs/.gitkeep

# Curated manuscript-ready tables/figures may be tracked selectively.
# Generated scratch files should remain ignored unless intentionally staged.

# Generated summary outputs.
results/tables/*
results/figures/*

!results/tables/.gitkeep
!results/figures/.gitkeep

# Environments/cache.
.venv/
__pycache__/
.Rhistory
.RData
.julia/
.snakemake/
snakemake_cache/
.conda/
.mamba/

# OS/editor.
.DS_Store
.vscode/
.idea/

*codebase*

# Generated comparator outputs.
results/raw/comparators/*
results/raw/comparisons/*
results/processed/comparisons/*

# Generated comparator outputs.
results/raw/comparators/*
results/raw/comparisons/*
results/processed/comparisons/*
