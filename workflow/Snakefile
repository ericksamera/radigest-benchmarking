    log:
        stdout="benchmark/logs/digital_radigest__{dataset}__{condition}.stdout.log",
        stderr="benchmark/logs/digital_radigest__{dataset}__{condition}.stderr.log"
    params:
        radigest=config["radigest"],
        enzymes=lambda wc: condition_row(wc.condition)["enzymes"],
        min_size=lambda wc: condition_min(condition_row(wc.condition)),
        max_size=lambda wc: condition_max(condition_row(wc.condition)),
        extra=lambda wc: " ".join(
            x for x in [
                behavior_flags(condition_row(wc.condition)),
                extra_condition_args(wc.condition),
            ] if x
        ),
        threads=config.get("threads", 1)
    shell:
        r"""
        mkdir -p results/raw/comparisons/radigest_tsv benchmark/logs
        {params.radigest:q} \
          -fasta {input.ref:q} \
          -enzymes {params.enzymes:q} \
          -min {params.min_size} \
          -max {params.max_size} \
          -threads {params.threads} \
          {params.extra} \
          -fragments-tsv {output.tsv:q} \
          -json {output.json:q} \
          > {log.stdout:q} 2> {log.stderr:q}
        """


rule normalize_radigest_for_digital:
    input:
        "results/raw/comparisons/radigest_tsv/{dataset}__{condition}.fragments.tsv"
    output:
        "results/processed/intervals/radigest_for_digital/{dataset}__{condition}.normalized.tsv"
    shell:
