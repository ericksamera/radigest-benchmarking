rule pair_screen_all:
    input:
        "results/tables/ranked_pairs.tsv"


rule pair_screen:
    input:
        ref=lambda wc: dataset_path(config["pair_screen"]["dataset"]),
        enzymes=config["pair_screen"]["enzymes"]
    output:
        ranked="results/tables/ranked_pairs.tsv"
    log:
        "benchmark/logs/pair_screen.log"
    params:
        screen=config["radigest_screen_pairs"],
        rank=config["radigest_rank_pairs"],
        outdir="results/raw/pair_screen",
        min_size=config["pair_screen"]["min_size"],
        max_size=config["pair_screen"]["max_size"],
        score_min=config["pair_screen"]["score_min"],
        score_max=config["pair_screen"]["score_max"],
        size_model=config["pair_screen"]["size_model"],
        jobs=config["pair_screen"]["jobs"],
        radigest_threads=config["pair_screen"]["radigest_threads"],
        objective=config["pair_screen"]["objective"]
    shell:
        r"""
        mkdir -p results/raw/pair_screen results/tables benchmark/logs
        {
          {params.screen:q} \
            --fasta {input.ref:q} \
            --enzymes {input.enzymes:q} \
            --min {params.min_size} \
            --max {params.max_size} \
            --score-min {params.score_min} \
            --score-max {params.score_max} \
            --size-model {params.size_model:q} \
            --jobs {params.jobs} \
            --radigest-threads {params.radigest_threads} \
            --out-dir {params.outdir:q}

          {params.rank:q} 'results/raw/pair_screen/json/*.json' \
            --fasta {input.ref:q} \
            --objective {params.objective:q} \
            --out {output.ranked:q}
        } > {log:q} 2>&1
        """
