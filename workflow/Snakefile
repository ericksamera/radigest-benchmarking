        mkdir -p results/processed/intervals/radigest_for_digital
        python3 scripts/normalize_radigest_tsv.py \
          --input {input:q} \
          --output {output:q} \
          --source-tool radigest \
          --hard-kept-only
        """


rule digital_rads_run:
    input:
        ref=lambda wc: dataset_path(wc.dataset),
        script=lambda wc: config["digital_rads"]["script"],
        enzymes="config/enzymes.tsv"
    output:
        raw="results/raw/comparators/digital_rads/{dataset}__{condition}.raw.tsv",
        summary="results/raw/comparators/digital_rads/{dataset}__{condition}.run_summary.tsv",
        version="results/raw/comparators/digital_rads/{dataset}__{condition}.version.txt",
        stdout="benchmark/logs/digital_rads__{dataset}__{condition}.stdout.log",
        stderr="benchmark/logs/digital_rads__{dataset}__{condition}.stderr.log"
    params:
        workdir=lambda wc: f"results/raw/comparators/digital_rads/work/{wc.dataset}__{wc.condition}",
        enzyme1=digital_enzyme1,
        enzyme2=digital_enzyme2,
        min_size=lambda wc: condition_min(condition_row(wc.condition)),
        max_size=lambda wc: condition_max(condition_row(wc.condition))
    shell:
        r"""
        mkdir -p results/raw/comparators/digital_rads benchmark/logs
        bash scripts/run_digital_rads.sh \
          --digital-rads {input.script:q} \
          --reference {input.ref:q} \
          --enzyme1 {params.enzyme1:q} \
          --enzyme2 {params.enzyme2:q} \
          --min {params.min_size} \
          --max {params.max_size} \
          --enzymes-tsv {input.enzymes:q} \
          --work-dir {params.workdir:q} \
          --raw-out {output.raw:q} \
          --summary-out {output.summary:q} \
          --version-out {output.version:q} \
          --stdout-log {output.stdout:q} \
          --stderr-log {output.stderr:q}
        """


rule normalize_digital_rads:
    input:
        raw="results/raw/comparators/digital_rads/{dataset}__{condition}.raw.tsv",
        enzymes="config/enzymes.tsv"
    output:
        normalized="results/processed/intervals/digital_rads/{dataset}__{condition}.normalized.tsv",
        summary="results/processed/intervals/digital_rads/{dataset}__{condition}.normalize_summary.tsv"
    params:
        enzyme1=digital_enzyme1,
        enzyme2=digital_enzyme2,
        min_size=lambda wc: condition_min(condition_row(wc.condition)),
        max_size=lambda wc: condition_max(condition_row(wc.condition))
    shell:
        r"""
        mkdir -p results/processed/intervals/digital_rads
        python3 scripts/normalize_digital_rads.py \
          --input {input.raw:q} \
          --output {output.normalized:q} \
          --summary {output.summary:q} \
          --enzymes-tsv {input.enzymes:q} \
          --enzyme1 {params.enzyme1:q} \
          --enzyme2 {params.enzyme2:q} \
          --min {params.min_size} \
          --max {params.max_size}
        """


rule compare_radigest_digital_rads_intervals:
    input:
        first="results/processed/intervals/radigest_for_digital/{dataset}__{condition}.normalized.tsv",
        second="results/processed/intervals/digital_rads/{dataset}__{condition}.normalized.tsv"
    output:
        summary="results/processed/comparisons/digital_rads/{dataset}__{condition}.summary.tsv",
        matching="results/processed/comparisons/digital_rads/{dataset}__{condition}.matching.tsv",
        only_first="results/processed/comparisons/digital_rads/{dataset}__{condition}.only_first.tsv",
        only_second="results/processed/comparisons/digital_rads/{dataset}__{condition}.only_second.tsv"
    params:
        prefix=lambda wc: f"results/processed/comparisons/digital_rads/{wc.dataset}__{wc.condition}"
    shell:
        r"""
        mkdir -p results/processed/comparisons/digital_rads
        python3 scripts/compare_interval_sets.py \
          --first {input.first:q} \
          --second {input.second:q} \
          --first-name radigest \
          --second-name Digital_RADs.py \
          --mode exact \
          --out-prefix {params.prefix:q} \
          --fail-on-difference
        """

