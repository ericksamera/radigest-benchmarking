    shell:
        r"""
        mkdir -p results/processed/comparisons/simrad
        python3 scripts/compare_radigest_simrad_counts.py \
          --radigest-json {input.radigest:q} \
          --simrad-tsv {input.simrad:q} \
          --dataset {wildcards.dataset:q} \
          --condition {wildcards.condition:q} \
          --out {output:q}
        """

# --- Digital_RADs.py coordinate comparator rules ---

DIGITAL_RADS_DATASETS = list(config.get("digital_rads", {}).get("datasets", []))
DIGITAL_RADS_CONDITIONS = list(config.get("digital_rads", {}).get("conditions", []))


def digital_rads_outputs():
    return [
        f"results/processed/comparisons/digital_rads/{dataset}__{condition}.summary.tsv"
        for dataset, condition in product(DIGITAL_RADS_DATASETS, DIGITAL_RADS_CONDITIONS)
    ]


def digital_enzyme1(wc):
    return enzyme_parts_for_condition(wc.condition)[0]


def digital_enzyme2(wc):
    parts = enzyme_parts_for_condition(wc.condition)
    if len(parts) != 2:
        raise ValueError(f"Digital_RADs.py comparison requires exactly two enzymes for condition {wc.condition}")
    return parts[1]


rule compare_digital_rads_all:
    input:
        digital_rads_outputs()


